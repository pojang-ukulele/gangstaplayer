{
  "name": "gangsta-player-pro-3",
  "productName": "Gangsta Player Pro 3",
  "version": "3.1.1",
  "description": "Gangsta Player Pro 3 - The Ultimate Sampler",
  "main": "main.js",
  "author": "Gangsta Player Pro 3",
  "license": "Proprietary",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "webmidi": "^3.1.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "playwright": "^1.42.1"
  },
  "build": {
    "appId": "com.gangsta.playerpro3",
    "productName": "Gangsta Player Pro 3",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName} Mac Installer ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gangsta Player Pro 3"
    },
    "files": [
      "**/*",
      "!**/node_modules/**/node_modules",
      "!**/*.wanha",
      "!**/*.map",
      "!**/venv/**",
      "!**/venv",
      "!**/__pycache__/**",
      "!**/recordings/**",
      "!ugplayer backup files/**",
      "!dist/**",
      "!Sonetra-AI-Mixer-main/**",
      "!**/*.zip",
      "!**/*.7z"
    ],
    "extraResources": [
      "README.txt"
    ]
  }
}
