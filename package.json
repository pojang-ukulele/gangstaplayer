{
  "name": "ug-gangsta-player-pro-3",
  "productName": "UG Gangsta Player Pro 3",
  "version": "3.0.0",
  "description": "Cracked by OG RAJIZ",
  "main": "main.js",
  "author": "OG RAJIZ",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "webmidi": "^3.1.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ograjiz.uggangstaplayerpro3",
    "productName": "UG Gangsta Player Pro 3",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName} Mac Installer ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UG Gangsta Player Pro 3"
    },
    "files": [
      "**/*",
      "!**/node_modules/**/node_modules",
      "!**/*.wanha",
      "!**/*.map",
      "!**/venv/**",
      "!**/venv",
      "!**/__pycache__/**",
      "!**/recordings/**",
      "!ugplayer backup files/**",
      "!dist/**",
      "!Sonetra-AI-Mixer-main/**",
      "!**/.git/**",
      "!**/*.zip",
      "!**/*.7z"
    ],
    "extraResources": [
      {
        "from": "soundpacks",
        "to": "soundpacks",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}