{
  "name": "gangsta-player-pro-3",
  "productName": "Gangsta Player Pro 3",
  "version": "4.20.1",
  "description": "Gangsta Player Pro 3 - The Ultimate Sampler",
  "main": "main.js",
  "author": "Gangsta Player Pro 3",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/build.js && electron app-build",
    "build:prod": "node scripts/build.js --prod",
    "typecheck": "tsc --noEmit",
    "pre-dist": "node scripts/build.js --prod",
    "dist": "electron-builder",
    "test": "jest",
    "test:unit": "jest --coverage",
    "test:smoke": "node scripts/build.js && jest tests/smoke.test.js --coverage=false --testPathIgnorePatterns=/node_modules/ /app-build/ /dist/ /dist_source/",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/webmidi": "^2.1.0",
    "electron": "^43.7.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "playwright": "^1.42.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^11.0.1"
  },
  "build": {
    "appId": "com.gangsta.playerpro3",
    "productName": "Gangsta Player Pro 3",
    "asar": true,
    "directories": {
      "app": "app-build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName} Mac Installer ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gangsta Player Pro 3"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "icon.png",
      "package.json",
      "README.md",
      "assets/**/*",
      "js/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/form-data/**/*",
      "node_modules/asynckit/**/*",
      "node_modules/combined-stream/**/*",
      "node_modules/delayed-stream/**/*",
      "node_modules/mime-types/**/*",
      "node_modules/mime-db/**/*",
      "node_modules/es-set-tostringtag/**/*",
      "node_modules/hasown/**/*",
      "node_modules/get-intrinsic/**/*",
      "node_modules/es-errors/**/*",
      "node_modules/es-object-atoms/**/*",
      "node_modules/es-define-property/**/*",
      "node_modules/gopd/**/*",
      "node_modules/dunder-proto/**/*",
      "node_modules/get-proto/**/*",
      "node_modules/has-symbols/**/*",
      "node_modules/has-tostringtag/**/*",
      "node_modules/function-bind/**/*",
      "node_modules/call-bind-apply-helpers/**/*",
      "node_modules/math-intrinsics/**/*",
      "!**/*.map"
    ],
  "asarUnpack": [
    "node_modules/better-sqlite3/prebuilds/*.node",
    "js/workers/*.js",
    "js/boot-fallback.js"
  ],
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "python-embed",
        "to": "python-embed",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
