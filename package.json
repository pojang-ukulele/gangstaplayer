{
  "name": "gangsta-player-pro-3",
  "productName": "Gangsta Player Pro 3",
  "version": "4.18.0",
  "description": "Gangsta Player Pro 3 - The Ultimate Sampler",
  "main": "main.js",
  "author": "Gangsta Player Pro 3",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/build.js && electron app-build",
    "build:prod": "node scripts/build.js --prod",
    "dist": "electron-builder",
    "test": "jest",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "setup:sonetra": "pip install -r sonetra-requirements.txt",
    "setup:sonetra:win": "py -m pip install -r sonetra-requirements.txt"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "form-data": "^4.0.5",
    "webmidi": "^3.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/webmidi": "^2.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "playwright": "^1.42.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^11.0.1"
  },
  "build": {
    "appId": "com.gangsta.playerpro3",
    "productName": "Gangsta Player Pro 3",
    "directories": {
      "app": "app-build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "${productName} Setup ${version} 2026-03-16.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName} Mac Installer ${version} 2026-03-16.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gangsta Player Pro 3"
    },
    "files": [
      "**/*",
      "!**/node_modules/**/node_modules",
      "!**/*.wanha",
      "!**/*.map",
      "!**/venv/**",
      "!**/venv",
      "!**/__pycache__/**",
      "!**/recordings/**",
      "!ugplayer backup files/**",
      "!dist/**",
      "!Sonetra-AI-Mixer-main/**",
      "!**/*.zip",
      "!**/*.7z"
    ],
    "extraResources": [
      "README.md"
    ]
  }
}
